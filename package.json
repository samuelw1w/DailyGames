{
  "name": "daily-games",
  "private": true,
  "type": "module",
  "description": "Daily Hub: a hub of small daily puzzle games, with a Cloudflare Workers + D1 backend.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply daily-games --local",
    "db:migrate": "wrangler d1 migrations apply daily-games --remote",
    "deploy": "wrangler deploy",
    "orbit:levels": "node tools/orbit-levels.js",
    "pegs:levels": "node tools/pegs-levels.js",
    "test": "node --test --no-warnings \"tests/*.test.js\""
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
